# Variables de entorno de JobTrack.
# Copia este fichero a .env.local (no se versiona) y rellena los valores.
# Nunca pongas valores reales en este fichero.

# URL del proyecto de Supabase (se usa desde el hito 2).
# Dónde: panel de Supabase > Project Settings > API > Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (anon/publishable) de Supabase (se usa desde el hito 2).
# Dónde: panel de Supabase > Project Settings > API Keys > clave anon o publishable.
# Nunca uses aquí la clave secreta del proyecto: la seguridad la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Email del usuario de prueba para los tests e2e con Playwright (hito 4).
# Dónde: panel de Supabase > Authentication > Users > crea un usuario de prueba.
E2E_USER_EMAIL=

# Contraseña de ese usuario de prueba (hito 4).
E2E_USER_PASSWORD=

# Email del usuario de prueba de producción para el smoke de `npm run e2e:prod` (hito 9).
# Tiene que existir ya en el entorno desplegado: el smoke no registra usuarios.
# No lo usa `npm run e2e` local, que usa E2E_USER_EMAIL/E2E_USER_PASSWORD.
E2E_PROD_USER_EMAIL=

# Contraseña de ese usuario de prueba de producción (hito 9).
E2E_PROD_USER_PASSWORD=

# URL base contra la que se ejecuta el smoke e2e de `npm run e2e:prod` (hito 9).
# Vacía: usa la URL de producción (https://jobtrack-brown-two.vercel.app).
# No la usa `npm run e2e`, que siempre prueba contra http://localhost:3000.
PLAYWRIGHT_BASE_URL=
